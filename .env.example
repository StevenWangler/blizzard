# Environment Variables for Snow Day AI Agent System
# Copy this file to .env and fill in your actual API keys

# OpenAI API Key (required for AI agents)
# Get from: https://platform.openai.com/api-keys
# Cost: ~$0.01-0.10 per prediction depending on model usage
OPENAI_API_KEY=sk-your-openai-api-key-here

# Optional server-side weather provider for local forecasts. Rockford uses NWS by default.
# WEATHER_API_KEY=your-weatherapi-com-key-here

# Location for weather forecasts (optional)
# Default is Rockford, MI (49341)
# Can be ZIP code, city name, coordinates, etc.
VITE_ZIP_CODE=49341

# Optional: Base path when hosting under a subdirectory (e.g., GitHub Pages project sites)
# Leave commented to serve from the domain root
# VITE_BASE_PATH=/snowday-forecast/

# Optional: For debugging and development
# NODE_ENV=development

# Off-season site mode (optional)
# true = normal Blizzard forecasting app
# false = lightweight spring/summer landing page and no scheduled AI prediction generation
VITE_BLIZZARD_ACTIVE=true