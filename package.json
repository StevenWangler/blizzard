{
    "name": "blizzard",
    "private": true,
    "version": "0.0.0",
    "type": "module",
    "scripts": {
        "dev": "vite --config config/vite.config.ts",
        "kill": "fuser -k 5000/tcp",
        "build": "tsc --build config/tsconfig.json && vite build --config config/vite.config.ts",
        "lint": "eslint .",
        "optimize": "vite optimize --config config/vite.config.ts",
        "preview": "vite preview --config config/vite.config.ts",
        "validate-deployment": "node build-tools/validate-deployment.mjs",
        "setup-deployment": "node build-tools/setup-deployment.mjs",
        "setup-keys": "node build-tools/setup-keys.mjs",
        "create-test-data": "node build-tools/create-test-data.mjs",
        "compare:reasoning": "node build-tools/generate-prediction.mjs --compare-reasoning",
        "replay:forecasts": "node build-tools/replay-forecasts.mjs",
        "generate-prediction": "node build-tools/generate-prediction.mjs",
        "preview:refresh": "node build-tools/refresh-preview.mjs",
        "generate-prediction:local": "node build-tools/generate-prediction.mjs --local",
        "test": "vitest run --config config/vitest.config.ts && npm run test:backend",
        "test:watch": "vitest --config config/vitest.config.ts",
        "typecheck": "tsc --build config/tsconfig.json --pretty false && npm run typecheck:sdk",
        "test:backend": "node --test build-tools/tests/*.test.mjs",
        "build:release": "BLIZZARD_RELEASE_BUILD=true npm run build && node build-tools/verify-dist.mjs --require-music",
        "verify:dist": "node build-tools/verify-dist.mjs",
        "typecheck:sdk": "tsc --strict --noEmit --skipLibCheck false --target ES2022 --module ESNext --moduleResolution Bundler --types node build-tools/tests/sdk-types.contract.ts"
    },
    "dependencies": {
        "@heroicons/react": "^2.2.0",
        "@hookform/resolvers": "^4.1.3",
        "@octokit/core": "^6.1.4",
        "@openai/agents": "^0.21.0",
        "@phosphor-icons/react": "^2.1.7",
        "@radix-ui/colors": "^3.0.0",
        "@radix-ui/react-accordion": "^1.2.20",
        "@radix-ui/react-alert-dialog": "^1.1.23",
        "@radix-ui/react-aspect-ratio": "^1.1.15",
        "@radix-ui/react-avatar": "^1.3.1",
        "@radix-ui/react-checkbox": "^1.3.11",
        "@radix-ui/react-collapsible": "^1.1.20",
        "@radix-ui/react-context-menu": "^2.3.7",
        "@radix-ui/react-dialog": "^1.1.23",
        "@radix-ui/react-dropdown-menu": "^2.1.24",
        "@radix-ui/react-hover-card": "^1.1.23",
        "@radix-ui/react-label": "^2.1.15",
        "@radix-ui/react-menubar": "^1.1.24",
        "@radix-ui/react-navigation-menu": "^1.2.22",
        "@radix-ui/react-popover": "^1.1.23",
        "@radix-ui/react-progress": "^1.1.16",
        "@radix-ui/react-radio-group": "^1.4.7",
        "@radix-ui/react-scroll-area": "^1.2.18",
        "@radix-ui/react-select": "^2.3.7",
        "@radix-ui/react-separator": "^1.1.15",
        "@radix-ui/react-slider": "^1.4.7",
        "@radix-ui/react-slot": "^1.3.3",
        "@radix-ui/react-switch": "^1.3.7",
        "@radix-ui/react-tabs": "^1.1.21",
        "@radix-ui/react-toggle": "^1.1.18",
        "@radix-ui/react-toggle-group": "^1.1.19",
        "@radix-ui/react-tooltip": "^1.2.16",
        "@tailwindcss/container-queries": "^0.1.1",
        "@tailwindcss/vite": "^4.3.3",
        "@tanstack/react-query": "^5.102.8",
        "class-variance-authority": "^0.7.1",
        "clsx": "^2.1.1",
        "cmdk": "^1.1.1",
        "d3": "^7.9.0",
        "date-fns": "^3.6.0",
        "dompurify": "^3.4.17",
        "dotenv": "^17.4.2",
        "embla-carousel-react": "^8.5.2",
        "framer-motion": "^12.43.0",
        "input-otp": "^1.5.0",
        "lucide-react": "^0.484.0",
        "marked": "^15.0.7",
        "next-themes": "^0.4.6",
        "openai": "7.47.0",
        "octokit": "^4.1.2",
        "react": "^19.2.8",
        "react-day-picker": "^9.14.0",
        "react-dom": "^19.2.8",
        "react-error-boundary": "^6.1.5",
        "react-hook-form": "^7.87.0",
        "react-resizable-panels": "^2.1.7",
        "recharts": "^2.15.1",
        "sonner": "^2.0.8",
        "tailwind-merge": "^3.6.0",
        "three": "^0.175.0",
        "tw-animate-css": "^1.2.4",
        "uuid": "^11.1.1",
        "vaul": "^1.1.2",
        "zod": "^4.6.7"
    },
    "devDependencies": {
        "@eslint/js": "^9.39.5",
        "@tailwindcss/postcss": "^4.3.3",
        "@types/react": "^19.2.18",
        "@types/react-dom": "^19.2.7",
        "@vitejs/plugin-react": "^4.3.4",
        "@vitejs/plugin-react-swc": "^3.10.1",
        "eslint": "^9.39.5",
        "eslint-plugin-react-hooks": "^5.2.0",
        "eslint-plugin-react-refresh": "^0.4.26",
        "globals": "^16.0.0",
        "tailwindcss": "^4.3.3",
        "typescript": "~5.7.2",
        "typescript-eslint": "^8.70.0",
        "vite": "^6.4.3",
        "vitest": "^5.0.0"
    },
    "engines": {
        "node": ">=22.12.0"
    },
    "workspaces": {
        "packages": [
            "packages/*"
        ]
    }
}
